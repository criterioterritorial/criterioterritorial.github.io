<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1080" height="1350" viewBox="0 0 1080 1350" role="img" aria-labelledby="title description">
  <title id="title">Criterio Territorial — Del dato al criterio.</title>
  <desc id="description">Criterio Territorial convierte información dispersa en evidencia: datos, análisis, territorio y decisión.</desc>
  <!-- Social Design v2 / STATEMENT. Gráfico abstracto sin datos geográficos.
       Los textos permanecen editables. Símbolos internos: sin dependencias externas. -->
  <defs>
    <symbol id="motif-grid" viewBox="0 0 920 640">
      <g fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.22">
        <path d="M0 80H920 M0 240H920 M0 400H920 M0 560H920 M80 0V640 M240 0V640 M400 0V640 M560 0V640 M720 0V640 M880 0V640"/>
        <path d="M70 240H90 M80 230V250 M390 400H410 M400 390V410 M710 560H730 M720 550V570" stroke-width="3"/>
      </g>
    </symbol>
    <symbol id="motif-nodes" viewBox="0 0 920 640">
      <g fill="none" stroke="currentColor" stroke-width="2.5">
        <circle cx="80" cy="240" r="12"/><circle cx="400" cy="240" r="12"/>
        <circle cx="400" cy="560" r="12"/><circle cx="720" cy="400" r="12"/>
      </g>
      <circle cx="720" cy="80" r="10" fill="#B8734A"/>
    </symbol>
    <symbol id="motif-paths" viewBox="0 0 920 640">
      <g fill="none" stroke="currentColor" stroke-width="3" opacity="0.65">
        <path d="M92 240H388 M400 252V548 M412 560H560V400H708 M720 388V90"/>
        <path d="M400 228V80H708" stroke-dasharray="8 12"/>
      </g>
    </symbol>
    <symbol id="motif-boundary" viewBox="0 0 920 640">
      <g fill="none" stroke="currentColor" stroke-width="3" opacity="0.55">
        <path d="M160 80V0H560 M880 160V480H800 M640 640H160V400"/>
        <path d="M840 480H920 M880 440V520" stroke-width="1.5"/>
      </g>
    </symbol>
  </defs>
  <g id="background"><rect width="1080" height="1350" fill="#F3F0E8"/></g>
  <g id="metadata"><text x="84" y="108" font-family="'IBM Plex Mono', monospace" font-size="22" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="84" dy="0">CT / DATOS</tspan>
  </text></g>
  <g id="headline"><text x="84" y="260" font-family="'IBM Plex Sans', sans-serif" font-size="108" font-weight="500" letter-spacing="-2" fill="#152331">
    <tspan x="84" dy="0">Del dato</tspan>
    <tspan x="84" dy="120.96000000000001">al criterio.</tspan>
  </text></g>
  <g id="context"><text x="84" y="550" font-family="'IBM Plex Sans', sans-serif" font-size="42" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="84" dy="0">Convertimos información dispersa</tspan>
    <tspan x="84" dy="50.4">en evidencia territorial.</tspan>
  </text></g>
  <g id="sequence-1"><text x="84" y="720" font-family="'IBM Plex Mono', monospace" font-size="36" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="84" dy="0">DATOS</tspan>
  </text></g>
  <g id="sequence-arrow-1"><text x="110" y="775" font-family="'IBM Plex Mono', monospace" font-size="36" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="110" dy="0">→</tspan>
  </text></g>
  <g id="sequence-2"><text x="239" y="832" font-family="'IBM Plex Mono', monospace" font-size="36" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="239" dy="0">ANÁLISIS</tspan>
  </text></g>
  <g id="sequence-arrow-2"><text x="265" y="887" font-family="'IBM Plex Mono', monospace" font-size="36" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="265" dy="0">→</tspan>
  </text></g>
  <g id="sequence-3"><text x="394" y="944" font-family="'IBM Plex Mono', monospace" font-size="36" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="394" dy="0">TERRITORIO</tspan>
  </text></g>
  <g id="sequence-arrow-3"><text x="420" y="999" font-family="'IBM Plex Mono', monospace" font-size="36" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="420" dy="0">→</tspan>
  </text></g>
  <g id="sequence-4"><text x="549" y="1056" font-family="'IBM Plex Mono', monospace" font-size="36" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="549" dy="0">DECISIÓN</tspan>
  </text></g>
  <g id="territorial-graphic" color="#315A58" transform="translate(660 610)">
    <use href="#motif-boundary" x="0" y="0" width="340" height="410"/>
  </g>
  <g id="identifier"><text x="84" y="1250" font-family="'IBM Plex Mono', monospace" font-size="22" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="84" dy="0">CT</tspan>
  </text></g>
  <g id="slide-number"><text x="894" y="1250" font-family="'IBM Plex Mono', monospace" font-size="22" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="894" dy="0">03 / 05</tspan>
  </text></g>
</svg>
