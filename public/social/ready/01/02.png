  </text></g>
<circle cx="487" cy="586" r="7" fill="#B8734A"/>  <g id="context"><text x="84" y="1040" font-family="'IBM Plex Sans', sans-serif" font-size="42" font-weight="400" letter-spacing="0" fill="#F3F0E8">
    <tspan x="84" dy="0">Dónde ocurren y cómo se relacionan</tspan>
    <tspan x="84" dy="50.4">cambia la forma de entender un problema.</tspan>
  </text></g>
  <g id="identifier"><text x="84" y="1250" font-family="'IBM Plex Mono', monospace" font-size="22" font-weight="400" letter-spacing="0" fill="#F3F0E8">
