<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1080" height="1350" viewBox="0 0 1080 1350" role="img" aria-labelledby="title description">
  <title id="title">Criterio Territorial — ¿Para qué?</title>
  <desc id="description">Criterio Territorial: comparar, identificar, detectar, evaluar, caracterizar y priorizar, organizados en dos columnas.</desc>
  <!-- Social Design v2 / INFORMATION. Gráfico abstracto sin datos geográficos.
       Los textos permanecen editables. Símbolos internos: sin dependencias externas. -->
  <defs>
    <symbol id="motif-grid" viewBox="0 0 920 640">
      <g fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.22">
        <path d="M0 80H920 M0 240H920 M0 400H920 M0 560H920 M80 0V640 M240 0V640 M400 0V640 M560 0V640 M720 0V640 M880 0V640"/>
        <path d="M70 240H90 M80 230V250 M390 400H410 M400 390V410 M710 560H730 M720 550V570" stroke-width="3"/>
      </g>
    </symbol>
    <symbol id="motif-nodes" viewBox="0 0 920 640">
      <g fill="none" stroke="currentColor" stroke-width="2.5">
        <circle cx="80" cy="240" r="12"/><circle cx="400" cy="240" r="12"/>
        <circle cx="400" cy="560" r="12"/><circle cx="720" cy="400" r="12"/>
      </g>
      <circle cx="720" cy="80" r="10" fill="#B8734A"/>
    </symbol>
    <symbol id="motif-paths" viewBox="0 0 920 640">
      <g fill="none" stroke="currentColor" stroke-width="3" opacity="0.65">
        <path d="M92 240H388 M400 252V548 M412 560H560V400H708 M720 388V90"/>
        <path d="M400 228V80H708" stroke-dasharray="8 12"/>
      </g>
    </symbol>
    <symbol id="motif-boundary" viewBox="0 0 920 640">
      <g fill="none" stroke="currentColor" stroke-width="3" opacity="0.55">
        <path d="M160 80V0H560 M880 160V480H800 M640 640H160V400"/>
        <path d="M840 480H920 M880 440V520" stroke-width="1.5"/>
      </g>
    </symbol>
  </defs>
  <g id="background"><rect width="1080" height="1350" fill="#FAFAF8"/></g>
  <g id="metadata"><text x="84" y="108" font-family="'IBM Plex Mono', monospace" font-size="22" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="84" dy="0">CT / TERRITORIO</tspan>
  </text></g>
  <g id="headline"><text x="84" y="270" font-family="'IBM Plex Sans', sans-serif" font-size="108" font-weight="500" letter-spacing="-2" fill="#152331">
    <tspan x="84" dy="0">¿Para qué?</tspan>
  </text></g>
  <g id="verb-1"><text x="84" y="585" font-family="'IBM Plex Sans', sans-serif" font-size="44" font-weight="500" letter-spacing="0" fill="#152331">
    <tspan x="84" dy="0">COMPARAR</tspan>
  </text></g>
<line x1="84" y1="627" x2="504" y2="627" stroke="#152331" stroke-width="1.5" opacity="0.3"/>
  <g id="verb-2"><text x="560" y="585" font-family="'IBM Plex Sans', sans-serif" font-size="44" font-weight="500" letter-spacing="0" fill="#152331">
    <tspan x="560" dy="0">IDENTIFICAR</tspan>
  </text></g>
<line x1="560" y1="627" x2="980" y2="627" stroke="#152331" stroke-width="1.5" opacity="0.3"/>
  <g id="verb-3"><text x="84" y="775" font-family="'IBM Plex Sans', sans-serif" font-size="44" font-weight="500" letter-spacing="0" fill="#152331">
    <tspan x="84" dy="0">DETECTAR</tspan>
  </text></g>
<line x1="84" y1="817" x2="504" y2="817" stroke="#152331" stroke-width="1.5" opacity="0.3"/>
  <g id="verb-4"><text x="560" y="775" font-family="'IBM Plex Sans', sans-serif" font-size="44" font-weight="500" letter-spacing="0" fill="#152331">
    <tspan x="560" dy="0">EVALUAR</tspan>
  </text></g>
<line x1="560" y1="817" x2="980" y2="817" stroke="#152331" stroke-width="1.5" opacity="0.3"/>
  <g id="verb-5"><text x="84" y="965" font-family="'IBM Plex Sans', sans-serif" font-size="44" font-weight="500" letter-spacing="0" fill="#152331">
    <tspan x="84" dy="0">CARACTERIZAR</tspan>
  </text></g>
<line x1="84" y1="1007" x2="504" y2="1007" stroke="#152331" stroke-width="1.5" opacity="0.3"/>
  <g id="verb-6"><text x="560" y="965" font-family="'IBM Plex Sans', sans-serif" font-size="44" font-weight="500" letter-spacing="0" fill="#152331">
    <tspan x="560" dy="0">PRIORIZAR</tspan>
  </text></g>
<line x1="560" y1="1007" x2="980" y2="1007" stroke="#152331" stroke-width="1.5" opacity="0.3"/>
  <g id="territorial-graphic" color="#315A58" transform="translate(760 1040)">
    <use href="#motif-boundary" x="0" y="0" width="240" height="150"/>
  </g>
  <g id="identifier"><text x="84" y="1250" font-family="'IBM Plex Mono', monospace" font-size="22" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="84" dy="0">CT</tspan>
  </text></g>
  <g id="slide-number"><text x="894" y="1250" font-family="'IBM Plex Mono', monospace" font-size="22" font-weight="400" letter-spacing="0" fill="#152331">
    <tspan x="894" dy="0">04 / 05</tspan>
  </text></g>
</svg>
