---
import Layout from '../layouts/Layout.astro';
import StudyCard from '../components/StudyCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { getCollection } from 'astro:content';
const studies = (await getCollection('studies')).sort((a,b) => b.data.year - a.data.year || a.data.code.localeCompare(b.data.code)).slice(0,3);
const areas = [['Mercado','Localización, demanda y actividad económica.'],['Ciudad','Estructura urbana, accesibilidad y servicios.'],['Sociedad','Población, desigualdad y dinámicas sociales.'],['Ambiente','Condiciones ambientales y exposición territorial.'],['Territorio','Relaciones espaciales a distintas escalas.']];
---
<Layout>
  <section class="hero container">
    <div class="meta hero-meta">CT / INTELIGENCIA TERRITORIAL <span>MÉXICO</span></div>
    <h1>Datos, territorio,<br /><span>decisión.</span></h1>
    <div class="hero-bottom"><p>Convertimos información geográfica, social, económica y ambiental en evidencia para apoyar decisiones de localización, planeación e inversión.</p><div class="actions"><a class="button" href="/estudios/">Explorar estudios <span aria-hidden="true">↗</span></a><a class="text-link" href="/contacto/">Solicitar un análisis <span aria-hidden="true">↗</span></a></div></div>
    <div class="hero-rule meta" aria-hidden="true"><span>OBSERVAR / ANALIZAR / INTERPRETAR</span><span>01 — 05</span></div>
  </section>
  <section class="areas container"><div class="section-heading"><span class="meta">01 / ÁREAS DE ANÁLISIS</span><h2>Una mirada integrada<br />al territorio.</h2></div><div class="area-grid">{areas.map(([name, text],i) => <article><span class="meta muted">0{i+1}</span><h3>{name}</h3><p>{text}</p></article>)}</div></section>
  <section class="studies-section container"><div class="section-heading"><div><span class="meta">02 / ESTUDIOS RECIENTES</span><h2>Evidencia en contexto.</h2></div><a class="text-link" href="/estudios/">Todos los estudios <span aria-hidden="true">↗</span></a></div>{studies.map(study => <StudyCard study={study} />)}</section>
  <section class="method-band"><div class="container method-content"><div><span class="meta">03 / METODOLOGÍA</span><h2>Del dato a una<br />lectura con criterio.</h2></div><div><p>Planteamos preguntas claras, revisamos las fuentes y analizamos las relaciones espaciales. Documentamos los métodos, los alcances y las limitaciones para que cada hallazgo pueda interpretarse en su contexto.</p><a class="text-link" href="/metodologia/">Conocer el proceso <span aria-hidden="true">↗</span></a></div></div></section>
  <ContactCTA />
</Layout>
