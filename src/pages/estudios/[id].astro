---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() { return (await getCollection('studies')).map(study => ({ params: { id: study.id }, props: { study } })); }
const { study } = Astro.props;
const { data } = study;
const { Content } = await render(study);
---
<Layout title={data.title} description={data.summary}>
  <article class="container study-detail">
    <a class="text-link" href="/estudios/">← Volver a estudios</a>
    <div class="page-intro"><span class="meta">{data.code} / {data.status}</span><h1>{data.title}</h1><p>{data.summary}</p><div class="meta muted">{data.location} / {data.year}</div></div>
    <img class="detail-image" src={data.image} alt={data.imageAlt} width="960" height="600" />
    <div class="prose"><Content /><h2>Metodología</h2><ol>{data.methodology.map(item => <li>{item}</li>)}</ol><h2>Resultados</h2><ul>{data.results.map(item => <li>{item}</li>)}</ul><h2>Fuentes</h2><ul>{data.sources.map(source => <li>{source.url ? <a href={source.url}>{source.name}</a> : source.name}</li>)}</ul><h2>Documentación</h2><div class="actions">{data.reportUrl ? <a class="button" href={data.reportUrl}>Consultar informe ↗</a> : <p>Informe pendiente de publicación.</p>}{data.repositoryUrl ? <a class="text-link" href={data.repositoryUrl}>Ver repositorio ↗</a> : <p>Repositorio pendiente de publicación.</p>}</div></div>
  </article>
</Layout>
